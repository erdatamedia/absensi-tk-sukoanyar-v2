# Serves clean URLs (e.g. /login instead of /login.html) for the Next.js
# static export on Apache-based hosting (cPanel).

# Next.js's static export creates a same-named folder next to each route's
# .html file (e.g. both login.html and login/ exist, the latter holding
# route metadata). Without this, Apache/LiteSpeed auto-redirects /login to
# /login/ because the folder exists, before our rewrite rules below ever
# run — which then serves a directory listing instead of login.html.
DirectorySlash Off

DirectoryIndex index.html

RewriteEngine On

# If the exact file exists (css/js/images/etc.), serve it as-is.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# /some/route -> /some/route.html, if that file exists.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# /some/route/ -> /some/route/index.html, if that file exists.
RewriteCond %{REQUEST_FILENAME}index.html -f
RewriteRule ^(.*)/$ $1/index.html [L]

# Anything else that doesn't resolve to a real file -> custom 404 page.
ErrorDocument 404 /404.html
